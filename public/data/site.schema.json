            "type": "object",
            "additionalProperties": false,
            "required": [
              "heading",
              "description",
              "icon",
              "target"
            ],
            "properties": {
              "heading": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "enum": [
                  "tv",
                  "home",
                  "wifi",
                  "camera",
                  "audio",
                  "tools",
                  "shelf",
                  "window",
                  "door",
                  "paint",
                  "outlet",
                  "faucet"
                ]
              },
              "target": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "service_strip": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        }
