        "heading": {
          "type": "string"
        },
        "phone_label": {
          "type": "string"
        },
        "privacy_note": {
          "type": "string"
        },
        "service_placeholder": {
          "type": "string"
        },
        "service_label": {
          "type": "string"
        },
        "location_label": {
          "type": "string"
        },
        "success_message": {
          "type": "string"
        },
        "submit_label": {
          "type": "string"
        },
        "sending_label": {
          "type": "string"
        },
        "error_message": {
          "type": "string"
        },
        "email_label": {
          "type": "string"
        },
        "not_configured_message": {
          "type": "string"
        },
        "details_placeholder": {
          "type": "string"
        },
        "details_label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "timing_label": {
          "type": "string"
        }
      }
