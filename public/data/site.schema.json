{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seo",
    "brand",
    "header_button",
    "hero",
    "hero_showcase",
    "feature",
    "approach",
    "experience",
    "contact",
    "form",
    "footer",
    "ui"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "language",
        "canonical_url"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "canonical_url": {
          "type": "string"
        },
        "social_image": {
          "type": "string"
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "subtitle",
        "logo_alt"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "logo": {
          "type": "string"
        },
        "logo_alt": {
          "type": "string"
        }
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "target"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "header_button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "target"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "service_summary",
        "description",
        "primary_label",
        "primary_target",
        "secondary_label",
        "secondary_target",
        "note"
      ],
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "heading_lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
