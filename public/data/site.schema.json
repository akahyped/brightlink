        "service_summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "primary_label": {
          "type": "string"
        },
        "primary_target": {
          "type": "string"
        },
        "secondary_label": {
          "type": "string"
        },
        "secondary_target": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "hero_showcase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "location",
        "heading",
        "accent",
        "footer",
