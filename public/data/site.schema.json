        "heading": {
          "type": "string"
        },
        "email_subject": {
          "type": "string"
        },
        "eyebrow": {
          "type": "string"
        },
        "card_description": {
          "type": "string"
        },
        "phone_display": {
          "type": "string"
        },
        "call_label": {
          "type": "string"
        },
        "card_eyebrow": {
          "type": "string"
        },
        "phone_number": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "email_outline": {
          "type": "string"
        }
