        "name_label",
        "enabled",
        "heading",
        "phone_label",
        "privacy_note",
        "service_placeholder",
        "service_label",
        "location_label",
        "success_message",
        "submit_label",
        "sending_label",
        "error_message",
        "email_label",
        "not_configured_message",
        "details_placeholder",
        "details_label",
        "description",
        "timing_label"
      ],
      "properties": {
        "name_label": {
          "type": "string"
