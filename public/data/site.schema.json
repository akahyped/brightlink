        "link_target"
      ],
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "accent": {
          "type": "string"
        },
        "footer": {
          "type": "string"
        },
        "link_label": {
          "type": "string"
        },
        "link_target": {
          "type": "string"
