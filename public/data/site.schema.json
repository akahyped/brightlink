          "type": "string",
          "enum": [
            "tv",
            "home",
            "wifi",
            "camera",
            "audio",
            "tools",
            "shelf",
            "window",
            "door",
            "paint",
            "outlet",
            "faucet"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "icon",
              "label"
            ],
            "properties": {
              "icon": {
                "type": "string",
                "enum": [
                  "tv",
                  "home",
                  "wifi",
                  "camera",
                  "audio",
                  "tools",
                  "shelf",
                  "window",
                  "door",
                  "paint",
                  "outlet",
                  "faucet"
                ]
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
