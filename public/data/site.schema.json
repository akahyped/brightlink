        "faq_description"
      ],
      "properties": {
        "area_eyebrow": {
          "type": "string"
        },
        "area_heading": {
          "type": "string"
        },
        "area_description": {
          "type": "string"
        },
        "faq_eyebrow": {
          "type": "string"
