        "menu_label",
        "required_note",
        "selected_project_label"
      ],
      "properties": {
        "skip_label": {
          "type": "string"
        },
        "navigation_label": {
          "type": "string"
        },
        "menu_label": {
          "type": "string"
        },
        "required_note": {
          "type": "string"
        },
        "selected_project_label": {
